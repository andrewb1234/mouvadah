# Copy to `.env` and fill with real values. Do not commit `.env`.
#
# Local authentication remains authenticated: `python3 bootstrap.py` creates
# a local owner and a revocable per-user API key in the database. The API key
# is stored separately in an owner-only credentials file and is never a shared
# backend bypass secret. Hosted deployments MUST keep this false.
LOCAL_AUTH_ENABLED=false

# MCP reads the per-user key from this owner-only file. bootstrap.py creates
# it with mode 0600 and configures Windsurf when detected.
# MOUVADAH_CREDENTIALS_FILE=/home/you/.config/mouvadah/credentials.env
# Legacy TASKABLE_CREDENTIALS_FILE remains accepted during the compatibility
# window.

# Scoped GitHub PAT (read/write for MR linking). Leave blank if MR attach-only.
GITHUB_PAT=

# Vite client target. Point at the locally running FastAPI instance.
VITE_API_URL=http://localhost:8000/api/v1

# SQLite file location. Defaults to ~/.taskable/taskable.db when unset, which
# is the recommended path because it survives `git clean`, is easy to back up,
# and is the same location the docker-compose stack bind-mounts. Override only
# if you have a specific reason (alternate filesystem, running multiple
# instances side-by-side, etc).
# DATABASE_URL=sqlite:////absolute/path/to/taskable.db

# PostgreSQL (production). Use your Neon/connection string.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Optional direct PostgreSQL connection for cross-instance LISTEN/NOTIFY.
# Set this when DATABASE_URL uses a transaction pooler that cannot preserve
# session-level LISTEN state. Neon `-pooler` hosts are converted to their
# documented direct hostname automatically when this override is absent.
# REALTIME_DATABASE_URL=postgresql://user:pass@direct-host/dbname?sslmode=require

# Local development upgrades the database on application startup. Hosted
# deployments must run one migration job first, then start every app instance
# with MIGRATION_MODE=check to prevent concurrent migration attempts.
MIGRATION_MODE=upgrade

# Google OAuth is optional for loopback local mode and required for hosted use.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT secret for signing session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string

# Trusted public frontend origin used for the OAuth callback, post-login
# redirect, CORS, and cookie security. In production this MUST be the exact
# HTTPS origin registered with Google; do not include a path or credentials.
FRONTEND_URL=http://localhost:5173

# Stage-appropriate per-process sliding-window limits. Keep these positive.
# Multi-instance hosted deployments need a shared limiter before scaling out.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
ACTION_RATE_LIMIT=180
ACTION_RATE_WINDOW_SECONDS=60

# Reject oversized API payloads before parsing. The supported range is 16 KiB
# through 10 MiB; the 1 MiB default is ample for project and knowledge text.
MAX_REQUEST_BODY_BYTES=1048576

# Hosted workspace deletion remains recoverable for this many days. Production
# validation accepts 7-90 days; the supported default is 30.
DELETION_RECOVERY_DAYS=30

# When upgrading a production database created before workspace tenancy, set
# this to the exact Google account email that should own legacy projects.
# Unowned legacy projects remain inaccessible until an explicit owner matches.
# LEGACY_OWNER_EMAIL=owner@example.com

# Observability. Logs are always redacted JSON on stderr. The metrics endpoint
# stays hidden until a dedicated random token is configured. Do not reuse a
# user/API/database credential. Generate with: openssl rand -hex 32
LOG_LEVEL=INFO
# DEPLOYMENT_ENVIRONMENT=production
# METRICS_BEARER_TOKEN=

# Optional error aggregation. The application disables request bodies,
# headers, cookies, query strings, PII, and Sentry transaction sampling.
# SENTRY_DSN=

# Optional vendor-neutral W3C trace export. In production the endpoint must
# use HTTPS and may not contain credentials; set collector authentication in
# OTEL_EXPORTER_OTLP_HEADERS. Supply the collector base URL; the HTTP/protobuf
# exporters append /v1/traces and /v1/metrics.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example
OTEL_TRACE_SAMPLE_RATIO=0.1
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20collector-token

# Encrypted backup-runner configuration. These values belong on the isolated
# backup Cron Job, not in frontend variables or source control. Generate the
# encryption key with `openssl rand -base64 32`, escrow it outside the backup
# bucket, and retain old keys for every retained backup key ID.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_KEY_ID=primary
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=mouvadah/database
# BACKUP_S3_KMS_KEY_ID=
# BACKUP_MAX_AGE_SECONDS=129600
# RESTORE_DRILL_DATABASE_URL=
# RESTORE_DRILL_CONFIRM_DATABASE=mouvadah_restore_drill
# RESTORE_DRILL_PROTECTED_DATABASE_FINGERPRINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2

# Emergency switch: false disables hosted MCP/OAuth while preserving the app.
HOSTED_MCP_ENABLED=true
