# syntax=docker/dockerfile:1.7
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

ARG VCS_REF=unknown
ARG VERSION=dev

LABEL org.opencontainers.image.title="Mouvadah API" \
    org.opencontainers.image.description="Mouvadah human-agent control plane API" \
    org.opencontainers.image.source="https://github.com/andrewb1234/mouvadah" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.licenses="AGPL-3.0-only"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/mouvadah

WORKDIR /app

# Install only the hash-locked runtime dependency graph.
COPY api/requirements-runtime.txt ./api/requirements-runtime.txt
RUN pip install --require-hashes -r api/requirements-runtime.txt

# Copy the API package.
COPY api ./api
COPY mcp ./mcp
COPY LICENSE /usr/share/licenses/mouvadah/LICENSE
COPY NOTICE /usr/share/licenses/mouvadah/NOTICE
COPY THIRD_PARTY_NOTICES.md /usr/share/licenses/mouvadah/THIRD_PARTY_NOTICES.md

# Keep the runtime unprivileged. Compose may map this UID/GID to the invoking
# local user so bind-mounted data and credentials remain owner-writable.
RUN groupadd --gid 10001 mouvadah \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin mouvadah \
    && mkdir -p /app/data /home/mouvadah/.config/mouvadah \
    && chown -R 10001:10001 /app/data /home/mouvadah \
    && chmod 0755 /home/mouvadah /home/mouvadah/.config
VOLUME ["/app/data"]

ENV DATABASE_URL=sqlite:////app/data/taskable.db \
    MIGRATION_MODE=upgrade

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)"

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
